/**
 * @fileoverview Firestore Security Rules for the GarmentFlow application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for worker-related data
 * (attendance, overtime, production, salary, advance payments, bonus payments, and chats).
 * Workers can only access their own data. An admin role is assumed for reading any worker's
 * chat messages for support purposes.
 *
 * Data Structure:
 * - /workers/{workerId}: Stores worker profile information. The document ID is the worker's UID.
 * - /workers/{workerId}/...: Various subcollections for worker-specific data.
 * - /chats/{workerId}/messages/{messageId}: Chat messages between a worker and an admin.
 * - /expenses/{expenseId}: Expense records (potentially admin-only).
 * - /activityLogs/{activityLogId}: Activity log entries (potentially restricted access).
 *
 * Key Security Decisions:
 * - Workers can only read and write their own profile and related data.
 * - Workers can create chat messages in their own chat path.
 * - Admins (identified by a custom claim `isAdmin: true`) can read any chat.
 * - Listing other worker's data is disallowed.
 * - The exact authorization for expenses and activity logs is TBD but currently allows any signed-in user.
 *
 * Denormalization for Authorization:
 * - Worker subcollections include `workerId` field to allow authorization without `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated (user is signed in).
     */
    function isSignedIn() {
      return request.auth != null;
    }
    
    /**
     * @description Checks if the user has an 'isAdmin' custom claim.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.isAdmin == true;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided userId.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing document.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /workers/{workerId} collection.
     * @path /workers/{workerId}
     */
    match /workers/{workerId} {
      allow get: if isOwner(workerId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(workerId) && request.resource.data.id == workerId;
      allow update: if isExistingOwner(workerId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(workerId);
    }

    /**
     * @description Rules for worker-specific subcollections.
     */
    match /workers/{workerId}/{subcollection}/{docId} {
      allow get, list: if isOwner(workerId) || isAdmin();
      allow create: if isOwner(workerId) && request.resource.data.workerId == workerId;
      allow update: if isExistingOwner(workerId) && request.resource.data.workerId == resource.data.workerId;
      allow delete: if isExistingOwner(workerId);
    }
    
    /**
     * @description Rules for the /chats/{workerId}/messages/{messageId} collection.
     * @path /chats/{workerId}/messages/{messageId}
     */
    match /chats/{workerId}/messages/{messageId} {
        // Worker can read their own chat messages. Admin can read any chat message.
        allow get, list: if isOwner(workerId) || isAdmin();
        
        // Worker can create messages in their own chat.
        // Admin can create messages in any worker's chat (e.g. to reply).
        allow create: if (isOwner(workerId) && request.resource.data.senderId == workerId)
                      || (isAdmin() && request.resource.data.senderId == 'admin');

        // Messages are immutable once created.
        allow update, delete: if false;
    }

    /**
     * @description Rules for the /expenses/{expenseId} collection.
     * @path /expenses/{expenseId}
     * @principle Allows any signed in user to CUD. Should be restricted to admins.
     */
    match /expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Rules for the /activityLogs/{activityLogId} collection.
     * @path /activityLogs/{activityLogId}
     * @principle Allows any signed in user to CUD. Should be restricted.
     */
    match /activityLogs/{activityLogId} {
      allow read, write: if isSignedIn();
    }
  }
}
